# ===============================
#   GHOSTTY CONFIGURATION FILE
# ===============================

# --- General ---
auto-update = download
auto-update-channel = stable
clipboard-read = allow
confirm-close-surface = false
shell-integration = fish
window-save-state = always
window-theme = dark

# --- macOS Specific ---
macos-non-native-fullscreen = true
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
window-titlebar-foreground = #5c3aac

# --- Appearance ---
unfocused-split-opacity = 0.20
background = #181825
#background-blur = 10
#background-opacity = 0.98
cursor-color = #aae484
cursor-text = #000000
theme = Catppuccin Mocha
window-padding-x = 25
window-padding-balance = true

# --- Palette ---
# ── Custom Ghostty Palette ──
palette = 0=#313244
palette = 1=#f88a96
palette = 2=#aae484
palette = 3=#f0e893
palette = 4=#61c5fa
palette = 5=#dd99f4
palette = 6=#94e2d5
palette = 7=#c2daf6

palette = 8=#45475a
palette = 9=#fd9db2
palette = 10=#b4befe
palette = 11=#fbb470
palette = 12=#74c7ec
palette = 13=#f5c2e7
palette = 14=#89dceb
palette = 15=#f5e0dc

# --- Font Settings ---
font-family = "Maple Mono NF"
font-size = 23
font-feature = calt,ss11,ss03,ss10

font-thicken = true
font-thicken-strength = 130

# --- Behavior ---
mouse-hide-while-typing = true
mouse-shift-capture = true
quick-terminal-position = center
copy-on-select = true

# --- Keybindings ---
keybind = super+t=toggle_quick_terminal
keybind = super+enter=ignore

title = "💀"

