# ===============================
#   GHOSTTY CONFIGURATION FILE
# ===============================

# --- General ---
auto-update = download
auto-update-channel = stable
clipboard-read = allow
confirm-close-surface = false
shell-integration = fish
window-save-state = always
window-theme = dark


# --- macOS Specific ---
macos-non-native-fullscreen = true
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
window-titlebar-foreground = #5c3aac


# --- Appearance ---
unfocused-split-opacity = 0.20
#background-blur = 10
#background-opacity = 0.97
window-padding-x = 30
window-padding-balance = true

# --- CozyCat ---
palette = 0=#2b2c3b
palette = 1=#d8747f
palette = 2=#96c885
palette = 3=#ddd38a
palette = 4=#5aa3d9
palette = 5=#c694ed
palette = 6=#94e2d5
palette = 7=#b6c7df

palette = 8=#51546a
palette = 9=#e08fa6
palette = 10=#b4befe
palette = 11=#e8a76f
palette = 12=#74c7ec
palette = 13=#e3b1d8
palette = 14=#89dceb
palette = 15=#eed6d2

background = #201f34
cursor-color = #DDD38A
cursor-text = #000000

foreground = #b6c7df

selection-background = #5c5f73
selection-foreground = #cdd6f4

# --- Font Settings ---
font-family = "Maple Mono NF"
font-size = 20.5
font-feature = calt,zero, ss11, ss06, ss10, ss03


font-thicken = true
font-thicken-strength = 130

# --- Behavior ---
mouse-hide-while-typing = true
mouse-shift-capture = true
quick-terminal-position = center
copy-on-select = true

# --- Keybindings ---
keybind = super+t=toggle_quick_terminal
keybind = super+enter=ignore

# Force a fixed title with emoji
title = "🫦"
title-report = false
